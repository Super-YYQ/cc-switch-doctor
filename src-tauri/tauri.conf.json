{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CC Switch Doctor",
  "version": "0.1.0",
  "identifier": "io.ccswitch.doctor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CC Switch Doctor",
        "width": 1180,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://api.github.com; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "CC Switch Doctor Contributors",
    "category": "DeveloperTool",
    "shortDescription": "Read-only HTTP diagnostics for CC Switch providers",
    "longDescription": "CC Switch Doctor scans the local CC Switch database read-only and tests third-party API providers via pure HTTP without launching any AI CLI.",
    "copyright": "Copyright (c) 2026 CC Switch Doctor Contributors",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "startMenuFolder": "CC Switch Doctor"
      }
    }
  },
  "plugins": {}
}
